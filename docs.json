{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Limetax Helpcenter",
  "colors": {
    "primary": "#436fff",
    "light": "#5a85ff",
    "dark": "#2d55e8"
  },
  "favicon": {
    "light": "/images/logo_mark_black.png",
    "dark": "/images/logo_mark_white.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dokumentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "languages": [
      {
        "language": "de",
        "default": true,
        "groups": [
          {
            "group": "Erste Schritte",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Belege importieren",
            "icon": "inbox-in",
            "pages": [
              "belege/smartlogin-agent",
              "belege/manuell-herunterladen",
              "belege/import-probleme",
              "belege/fehlende-belege-anfordern"
            ]
          },
          {
            "group": "Kreditoren- und Debitorenbuchaltung",
            "icon": "file-invoice",
            "pages": [
              "rechnungen/status-verstehen",
              "rechnungen/eingangsrechnungen-pruefen",
              "rechnungen/belegansicht",
              "rechnungen/splitbuchungen",
              "rechnungen/manuell-buchen",
              "rechnungen/kreditor-anlegen",
              "rechnungen/ausgangsrechnungen",
              "rechnungen/wiederkehrende-buchungen",
              "rechnungen/ki-fragen"
            ]
          },
          {
            "group": "Bank",
            "icon": "building-columns",
            "pages": [
              "bank/welche-konten-wo",
              "bank/finanzkonten-anlegen",
              "bank/umsaetze-importieren",
              "bank/matching",
              "bank/durchlaufende-posten"
            ]
          },
          {
            "group": "Export nach DATEV",
            "icon": "arrow-right-from-bracket",
            "pages": [
              "export/stapel-uebertragen",
              "export/stapel-in-datev",
              "export/anlagenzugaenge"
            ]
          },
          {
            "group": "Chat & Recherche",
            "icon": "comments",
            "pages": [
              "chat/ueberblick",
              "chat/recherchequellen",
              "chat/mandant-und-rueckfragen",
              "chat/verlauf-und-teilen",
              "chat/gute-prompts",
              "chat/probleme"
            ]
          },
          {
            "group": "Sonstiges",
            "icon": "sliders",
            "pages": [
              "stammdaten/kostenstellen",
              "stammdaten/stammdaten-und-notiz",
              "stammdaten/tastenkuerzel"
            ]
          },
          {
            "group": "Funktionsstand",
            "icon": "list-check",
            "pages": [
              "funktionsstand/funktionsstand"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo_mark_black.png",
    "dark": "/images/logo_mark_white.png",
    "href": "https://www.limetax.de"
  },
  "navbar": {
    "links": [
      {
        "href": "mailto:kontakt@limetax.de",
        "label": "Support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Zur Limetax App",
      "href": "https://app.limetax.de"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://www.app.limetax.de"
    }
  },
  "search": {
    "prompt": "Helpcenter durchsuchen…"
  },
  "description": "Hilfe und Anleitungen zur Limetax App für Steuerkanzleien.",
